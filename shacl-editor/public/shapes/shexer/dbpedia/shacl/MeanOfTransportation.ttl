@prefix : <http://weso.es/shapes/> .
@prefix dbo: <http://dbpedia.org/ontology/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:MeanOfTransportation a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:dataType xsd:string ;
            sh:path dbo:shipDraft ],
        [ a sh:PropertyShape ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:engine ],
        [ a sh:PropertyShape ;
            sh:dataType xsd:string ;
            sh:path rdfs:comment ],
        [ a sh:PropertyShape ;
            sh:in ( owl:Thing ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path rdf:type ],
        [ a sh:PropertyShape ;
            sh:in ( dbo:Automobile ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path rdf:type ],
        [ a sh:PropertyShape ;
            sh:dataType xsd:string ;
            sh:path dbo:shipLaunch ],
        [ a sh:PropertyShape ;
            sh:dataType xsd:string ;
            sh:path dbo:wheelbase ],
        [ a sh:PropertyShape ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:class ],
        [ a sh:PropertyShape ;
            sh:in ( <http://www.wikidata.org/entity/Q11446> ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path rdf:type ],
        [ a sh:PropertyShape ;
            sh:dataType xsd:string ;
            sh:path dbo:topSpeed ],
        [ a sh:PropertyShape ;
            sh:in ( <http://www.wikidata.org/entity/Q11436> ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path rdf:type ],
        [ a sh:PropertyShape ;
            sh:dataType xsd:string ;
            sh:path dbo:commissioningDate ],
        [ a sh:PropertyShape ;
            sh:dataType xsd:string ;
            sh:path dbo:height ],
        [ a sh:PropertyShape ;
            sh:dataType xsd:string ;
            sh:maxCount 1 ;
            sh:path rdfs:label ],
        [ a sh:PropertyShape ;
            sh:dataType xsd:string ;
            sh:path dbo:width ],
        [ a sh:PropertyShape ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:manufacturer ],
        [ a sh:PropertyShape ;
            sh:dataType xsd:string ;
            sh:path dbo:shipBeam ],
        [ a sh:PropertyShape ;
            sh:dataType xsd:integer ;
            sh:path dbo:productionStartYear ],
        [ a sh:PropertyShape ;
            sh:dataType xsd:integer ;
            sh:path dbo:productionEndYear ],
        [ a sh:PropertyShape ;
            sh:dataType xsd:string ;
            sh:path dbo:decommissioningDate ],
        [ a sh:PropertyShape ;
            sh:dataType xsd:string ;
            sh:maxCount 1 ;
            sh:path dcat:resource_identifier ],
        [ a sh:PropertyShape ;
            sh:dataType xsd:string ;
            sh:path dbo:length ],
        [ a sh:PropertyShape ;
            sh:dataType xsd:string ;
            sh:path dbo:layingDown ],
        [ a sh:PropertyShape ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:builder ],
        [ a sh:PropertyShape ;
            sh:in ( dbo:MeanOfTransportation ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path rdf:type ],
        [ a sh:PropertyShape ;
            sh:in ( <http://schema.org/Product> ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path rdf:type ],
        [ a sh:PropertyShape ;
            sh:dataType xsd:string ;
            sh:path dbo:status ],
        [ a sh:PropertyShape ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:type ],
        [ a sh:PropertyShape ;
            sh:in ( dbo:Aircraft ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path rdf:type ],
        [ a sh:PropertyShape ;
            sh:dataType xsd:string ;
            sh:path foaf:name ],
        [ a sh:PropertyShape ;
            sh:dataType xsd:integer ;
            sh:path dbo:numberBuilt ],
        [ a sh:PropertyShape ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:country ],
        [ a sh:PropertyShape ;
            sh:nodeKind sh:IRI ;
            sh:path dbo:bodyStyle ],
        [ a sh:PropertyShape ;
            sh:in ( dbo:Ship ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path rdf:type ],
        [ a sh:PropertyShape ;
            sh:dataType xsd:integer ;
            sh:maxCount 1 ;
            sh:path dbo:wikiPageRevisionID ],
        [ a sh:PropertyShape ;
            sh:dataType xsd:string ;
            sh:path dbo:transmission ] ;
    sh:targetClass dbo:MeanOfTransportation .

