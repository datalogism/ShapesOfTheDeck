@prefix dbo: <http://dbpedia.org/ontology/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<file:///C:/Users/doccr/PycharmProjects/DoubleShapespresso/Airport> a sh:NodeShape ;
    sh:property [ sh:class dbo:City ;
            sh:minCount 0 ;
            sh:path dbo:city ],
        [ sh:datatype xsd:double ;
            sh:minCount 0 ;
            sh:path dbo:elevation ],
        [ sh:datatype xsd:string ;
            sh:minCount 0 ;
            sh:path dbo:faaLocationIdentifier ],
        [ sh:datatype xsd:string ;
            sh:minCount 0 ;
            sh:path dbo:iataLocationIdentifier ],
        [ sh:datatype xsd:string ;
            sh:minCount 0 ;
            sh:path dbo:icaoLocationIdentifier ],
        [ sh:class dbo:Place ;
            sh:minCount 0 ;
            sh:path dbo:location ],
        [ sh:class dbo:Organisation ;
            sh:minCount 0 ;
            sh:path dbo:operator ],
        [ sh:minCount 0 ;
            sh:or ( [ sh:class dbo:Organisation ] [ sh:class dbo:Agent ] [ sh:class owl:Thing ] ) ;
            sh:path dbo:owner ],
        [ sh:datatype xsd:string ;
            sh:minCount 0 ;
            sh:path dbo:runwayDesignation ],
        [ sh:datatype xsd:double ;
            sh:minCount 0 ;
            sh:path dbo:runwayLength ],
        [ sh:datatype xsd:string ;
            sh:minCount 0 ;
            sh:path dbo:runwaySurface ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path dbo:wikiPageRevisionID ],
        [ sh:class foaf:Document ;
            sh:minCount 0 ;
            sh:path foaf:homepage ],
        [ sh:datatype rdf:langString ;
            sh:minCount 0 ;
            sh:path foaf:name ],
        [ sh:datatype xsd:double ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:path dcat:resource_identifier ],
        [ sh:class dbo:Airport ;
            sh:maxCount 7 ;
            sh:minCount 6 ;
            sh:path rdf:type ],
        [ sh:datatype rdf:langString ;
            sh:minCount 0 ;
            sh:path rdfs:comment ],
        [ sh:datatype rdf:langString ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path rdfs:label ] ;
    sh:targetClass dbo:Airport .

