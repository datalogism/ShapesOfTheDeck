@prefix dbo: <http://dbpedia.org/ontology/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<file:///C:/Users/doccr/PycharmProjects/DoubleShapespresso/Artist> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:gYear ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:path dbo:activeYearsEndYear ],
        [ sh:datatype xsd:gYear ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:path dbo:activeYearsStartYear ],
        [ sh:datatype rdf:langString ;
            sh:minCount 0 ;
            sh:path dbo:alias ],
        [ sh:class dbo:Band ;
            sh:minCount 0 ;
            sh:path dbo:associatedBand ],
        [ sh:class dbo:Artist ;
            sh:minCount 0 ;
            sh:path dbo:associatedMusicalArtist ],
        [ sh:datatype xsd:string ;
            sh:minCount 0 ;
            sh:path dbo:background ],
        [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:path dbo:birthDate ],
        [ sh:class dbo:Place ;
            sh:minCount 0 ;
            sh:path dbo:birthPlace ],
        [ sh:datatype xsd:integer ;
            sh:minCount 0 ;
            sh:path dbo:birthYear ],
        [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:path dbo:deathDate ],
        [ sh:class dbo:Place ;
            sh:minCount 0 ;
            sh:path dbo:deathPlace ],
        [ sh:datatype xsd:integer ;
            sh:minCount 0 ;
            sh:path dbo:deathYear ],
        [ sh:minCount 0 ;
            sh:or ( [ sh:class dbo:Genre ] [ sh:class dbo:MusicGenre ] ) ;
            sh:path dbo:genre ],
        [ sh:class dbo:Place ;
            sh:minCount 0 ;
            sh:path dbo:hometown ],
        [ sh:class owl:Thing ;
            sh:minCount 0 ;
            sh:path dbo:instrument ],
        [ sh:class dbo:Artist ;
            sh:minCount 0 ;
            sh:path dbo:occupation ],
        [ sh:class dbo:Organisation ;
            sh:minCount 0 ;
            sh:path dbo:recordLabel ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path dbo:wikiPageRevisionID ],
        [ sh:datatype rdf:langString ;
            sh:minCount 0 ;
            sh:path foaf:givenName ],
        [ sh:datatype sh:IRI ;
            sh:minCount 0 ;
            sh:path foaf:homepage ],
        [ sh:datatype rdf:langString ;
            sh:minCount 0 ;
            sh:path foaf:name ],
        [ sh:datatype xsd:double ;
            sh:minCount 0 ;
            sh:path dcat:resource_identifier ],
        [ sh:class dbo:Artist ;
            sh:minCount 14 ;
            sh:path rdf:type ],
        [ sh:datatype rdf:langString ;
            sh:minCount 0 ;
            sh:path rdfs:comment ],
        [ sh:datatype rdf:langString ;
            sh:minCount 1 ;
            sh:path rdfs:label ] ;
    sh:targetClass dbo:Artist .

