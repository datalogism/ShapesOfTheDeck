@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <http://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix yago: <http://yago-knowledge.org/resource/> .

<http://shaclshapes.org/MusicGroupShape> a sh:NodeShape ;
    sh:property [ sh:node <http://shaclshapes.org/MusicGroupShape> ;
            sh:path yago:director ],
        [ sh:datatype <xsd:anyURI> ;
            sh:minCount 1 ;
            sh:path schema:mainEntityOfPage ],
        [ sh:node <http://shaclshapes.org/MusicGroupShape> ;
            sh:path yago:notableWork ],
        [ sh:datatype <xsd:anyURI> ;
            sh:path schema:image ],
        [ sh:datatype <rdf:langString> ;
            sh:path rdfs:comment ],
        [ sh:datatype <geo:wktLiteral> ;
            sh:path schema:geo ],
        [ sh:node <http://shaclshapes.org/MusicGroupShape> ;
            sh:path schema:locationCreated ],
        [ sh:maxCount 2 ;
            sh:minCount 1 ;
            sh:node <http://shaclshapes.org/MusicGroupShape> ;
            sh:path rdf:type ],
        [ sh:node <http://shaclshapes.org/MusicGroupShape> ;
            sh:path yago:ownedBy ],
        [ sh:nodeKind sh:IRI ;
            sh:path schema:knowsLanguage ],
        [ sh:datatype <xsd:dateTime> ;
            sh:path schema:dissolutionDate ],
        [ sh:datatype <xsd:anyURI> ;
            sh:path schema:url ],
        [ sh:node <http://shaclshapes.org/MusicGroupShape> ;
            sh:path yago:appearsIn ],
        [ sh:node <http://shaclshapes.org/MusicGroupShape> ;
            sh:path schema:location ],
        [ sh:datatype <rdf:langString> ;
            sh:path schema:alternateName ],
        [ sh:datatype <rdf:langString> ;
            sh:minCount 1 ;
            sh:path rdfs:label ],
        [ sh:node <http://shaclshapes.org/MusicGroupShape> ;
            sh:path schema:founder ],
        [ sh:datatype <xsd:anyURI> ;
            sh:path schema:logo ],
        [ sh:node <http://shaclshapes.org/MusicGroupShape> ;
            sh:path schema:award ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:node <http://shaclshapes.org/MusicGroupShape> ;
            sh:path owl:sameAs ],
        [ sh:node <http://shaclshapes.org/MusicGroupShape> ;
            sh:path yago:influencedBy ],
        [ sh:node <http://shaclshapes.org/MusicGroupShape> ;
            sh:path schema:recordLabel ],
        [ sh:datatype <xsd:dateTime> ;
            sh:path schema:dateCreated ],
        [ sh:datatype <xsd:string> ;
            sh:maxCount 2 ;
            sh:minCount 1 ;
            sh:path schema:sameAs ] ;
    sh:targetClass schema:MusicGroup .

