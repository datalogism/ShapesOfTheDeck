@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <http://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix yago: <http://yago-knowledge.org/resource/> .

<http://shaclshapes.org/WorkerShape> a sh:NodeShape ;
    sh:property [ sh:datatype <xsd:dateTime> ;
            sh:path schema:deathDate ],
        [ sh:nodeKind sh:IRI ;
            sh:path schema:spouse ],
        [ sh:node <http://shaclshapes.org/WorkerShape> ;
            sh:path schema:memberOf ],
        [ sh:class <http://dbpedia.org/ontology/Organisation> ;
            sh:path schema:worksFor ],
        [ sh:node <http://shaclshapes.org/WorkerShape> ;
            sh:path schema:alumniOf ],
        [ sh:node <http://shaclshapes.org/WorkerShape> ;
            sh:path schema:author ],
        [ sh:nodeKind sh:IRI ;
            sh:path yago:beliefSystem ],
        [ sh:datatype <xsd:string> ;
            sh:maxCount 3 ;
            sh:minCount 1 ;
            sh:path schema:sameAs ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:node <http://shaclshapes.org/WorkerShape> ;
            sh:path schema:birthPlace ],
        [ sh:nodeKind sh:IRI ;
            sh:path schema:deathPlace ],
        [ sh:datatype <xsd:anyURI> ;
            sh:minCount 1 ;
            sh:path schema:mainEntityOfPage ],
        [ sh:node <http://shaclshapes.org/WorkerShape> ;
            sh:path schema:performer ],
        [ sh:datatype <rdf:langString> ;
            sh:minCount 1 ;
            sh:path rdfs:comment ],
        [ sh:minCount 1 ;
            sh:node <http://shaclshapes.org/WorkerShape> ;
            sh:path rdf:type ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path owl:sameAs ],
        [ sh:datatype <rdf:langString> ;
            sh:path schema:alternateName ],
        [ sh:nodeKind sh:IRI ;
            sh:path schema:nationality ],
        [ sh:node <http://shaclshapes.org/WorkerShape> ;
            sh:path schema:award ],
        [ sh:datatype <rdf:langString> ;
            sh:minCount 1 ;
            sh:path rdfs:label ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:node <http://shaclshapes.org/WorkerShape> ;
            sh:path schema:gender ],
        [ sh:datatype <xsd:anyURI> ;
            sh:path schema:image ],
        [ sh:nodeKind sh:IRI ;
            sh:path yago:appearsIn ],
        [ sh:datatype <xsd:dateTime> ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path schema:birthDate ],
        [ sh:nodeKind sh:IRI ;
            sh:path schema:knowsLanguage ],
        [ sh:class <http://dbpedia.org/ontology/City> ;
            sh:path schema:homeLocation ] ;
    sh:targetClass yago:Worker .

