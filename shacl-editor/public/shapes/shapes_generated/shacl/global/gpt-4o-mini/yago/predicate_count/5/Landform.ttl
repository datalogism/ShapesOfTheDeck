@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <http://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix yago: <http://yago-knowledge.org/resource/> .

<http://shaclshapes.org/LandformShape> a sh:NodeShape ;
    sh:property [ sh:datatype <rdf:langString> ;
            sh:minCount 1 ;
            sh:path rdfs:comment ],
        [ sh:datatype <rdf:langString> ;
            sh:path schema:alternateName ],
        [ sh:datatype <rdf:langString> ;
            sh:minCount 1 ;
            sh:path rdfs:label ],
        [ sh:node <http://shaclshapes.org/LandformShape> ;
            sh:path yago:highestPoint ],
        [ sh:datatype <xsd:anyURI> ;
            sh:path schema:url ],
        [ sh:datatype <xsd:decimal> ;
            sh:maxCount 2 ;
            sh:path yago:elevation ],
        [ sh:datatype <xsd:anyURI> ;
            sh:minCount 1 ;
            sh:path schema:mainEntityOfPage ],
        [ sh:minCount 1 ;
            sh:node <http://shaclshapes.org/LandformShape> ;
            sh:path schema:location ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:node <http://shaclshapes.org/LandformShape> ;
            sh:path owl:sameAs ],
        [ sh:datatype <xsd:decimal> ;
            sh:path yago:area ],
        [ sh:datatype <xsd:string> ;
            sh:maxCount 2 ;
            sh:minCount 1 ;
            sh:path schema:sameAs ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:node <http://shaclshapes.org/LandformShape> ;
            sh:path rdf:type ],
        [ sh:datatype <xsd:anyURI> ;
            sh:path schema:image ],
        [ sh:datatype <geo:wktLiteral> ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path schema:geo ],
        [ sh:node <http://shaclshapes.org/LandformShape> ;
            sh:path yago:neighbors ] ;
    sh:targetClass schema:Landform .

