@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <http://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix yago: <http://yago-knowledge.org/resource/> .

<http://shaclshapes.org/AwardShape> a sh:NodeShape ;
    sh:property [ sh:datatype <xsd:anyURI> ;
            sh:path schema:url ],
        [ sh:class <http://dbpedia.org/ontology/Organisation> ;
            sh:path yago:conferredBy ],
        [ sh:datatype <rdf:langString> ;
            sh:path schema:alternateName ],
        [ sh:datatype <xsd:string> ;
            sh:path schema:isbn ],
        [ sh:nodeKind sh:IRI ;
            sh:path schema:inLanguage ],
        [ sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path owl:sameAs ],
        [ sh:node <http://shaclshapes.org/AwardShape> ;
            sh:path schema:author ],
        [ sh:datatype <rdf:langString> ;
            sh:minCount 1 ;
            sh:path rdfs:label ],
        [ sh:nodeKind sh:IRI ;
            sh:path schema:about ],
        [ sh:maxCount 3 ;
            sh:minCount 1 ;
            sh:node <http://shaclshapes.org/AwardShape> ;
            sh:path rdf:type ],
        [ sh:datatype <xsd:dateTime> ;
            sh:path schema:dateCreated ],
        [ sh:nodeKind sh:IRI ;
            sh:path schema:locationCreated ],
        [ sh:datatype <xsd:anyURI> ;
            sh:minCount 1 ;
            sh:path schema:mainEntityOfPage ],
        [ sh:datatype <rdf:langString> ;
            sh:path rdfs:comment ],
        [ sh:datatype <xsd:string> ;
            sh:maxCount 3 ;
            sh:minCount 1 ;
            sh:path schema:sameAs ],
        [ sh:datatype <xsd:anyURI> ;
            sh:path schema:image ] ;
    sh:targetClass yago:Award .

