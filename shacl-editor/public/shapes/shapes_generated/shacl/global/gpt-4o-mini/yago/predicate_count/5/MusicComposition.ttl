@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <http://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://shaclshapes.org/MusicCompositionShape> a sh:NodeShape ;
    sh:property [ sh:node <http://shaclshapes.org/MusicCompositionShape> ;
            sh:path schema:author ],
        [ sh:node <http://shaclshapes.org/MusicCompositionShape> ;
            sh:path schema:editor ],
        [ sh:datatype <xsd:anyURI> ;
            sh:minCount 1 ;
            sh:path schema:mainEntityOfPage ],
        [ sh:maxCount 2 ;
            sh:minCount 1 ;
            sh:node <http://shaclshapes.org/MusicCompositionShape> ;
            sh:path rdf:type ],
        [ sh:node <http://shaclshapes.org/MusicCompositionShape> ;
            sh:path schema:musicBy ],
        [ sh:datatype <rdf:langString> ;
            sh:path schema:alternateName ],
        [ sh:datatype <xsd:dateTime> ;
            sh:path schema:dateCreated ],
        [ sh:nodeKind sh:IRI ;
            sh:path schema:inLanguage ],
        [ sh:datatype <rdf:langString> ;
            sh:minCount 1 ;
            sh:path rdfs:label ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path owl:sameAs ],
        [ sh:datatype <xsd:string> ;
            sh:minCount 1 ;
            sh:path schema:sameAs ],
        [ sh:datatype <xsd:anyURI> ;
            sh:path schema:image ],
        [ sh:datatype <rdf:langString> ;
            sh:minCount 1 ;
            sh:path rdfs:comment ] ;
    sh:targetClass schema:MusicComposition .

