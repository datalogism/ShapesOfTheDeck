@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <http://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix yago: <http://yago-knowledge.org/resource/> .

<http://shaclshapes.org/SportsPersonShape> a sh:NodeShape ;
    sh:property [ sh:class schema:EducationalOrganization ;
            sh:path schema:alumniOf ],
        [ sh:class schema:Organization ;
            sh:path schema:worksFor ],
        [ sh:class yago:BeliefSystem ;
            sh:path yago:beliefSystem ],
        [ sh:datatype <xsd:string> ;
            sh:path schema:sameAs ],
        [ sh:node <http://shaclshapes.org/SportsPersonShape> ;
            sh:path schema:children ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:or ( [ sh:class yago:Female__u0028_gender_u0029_ ] [ sh:class yago:Male_gender ] ) ;
            sh:path schema:gender ],
        [ sh:datatype <xsd:dateTime> ;
            sh:maxCount 1 ;
            sh:path schema:birthDate ],
        [ sh:nodeKind sh:IRI ;
            sh:path schema:homeLocation ],
        [ sh:class yago:Award ;
            sh:path schema:award ],
        [ sh:datatype <rdf:langString> ;
            sh:path schema:alternateName ],
        [ sh:datatype <rdf:langString> ;
            sh:path rdfs:comment ],
        [ sh:datatype <xsd:dateTime> ;
            sh:maxCount 1 ;
            sh:path schema:deathDate ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path owl:sameAs ],
        [ sh:node <http://shaclshapes.org/SportsPersonShape> ;
            sh:path yago:notableWork ],
        [ sh:class schema:Organization ;
            sh:path schema:memberOf ],
        [ sh:minCount 1 ;
            sh:node <http://shaclshapes.org/SportsPersonShape> ;
            sh:path rdf:type ],
        [ sh:node <http://shaclshapes.org/SportsPersonShape> ;
            sh:path schema:spouse ],
        [ sh:datatype <xsd:anyURI> ;
            sh:minCount 1 ;
            sh:path schema:mainEntityOfPage ],
        [ sh:datatype <rdf:langString> ;
            sh:minCount 1 ;
            sh:path rdfs:label ],
        [ sh:class <http://dbpedia.org/ontology/City> ;
            sh:maxCount 1 ;
            sh:path schema:birthPlace ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path schema:nationality ],
        [ sh:class <http://dbpedia.org/ontology/City> ;
            sh:maxCount 1 ;
            sh:path schema:deathPlace ],
        [ sh:datatype <xsd:anyURI> ;
            sh:path schema:image ],
        [ sh:class yago:Language ;
            sh:path schema:knowsLanguage ],
        [ sh:datatype <xsd:anyURI> ;
            sh:path schema:url ] ;
    sh:targetClass yago:SportsPerson .

