@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <http://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix yago: <http://yago-knowledge.org/resource/> .

<http://shaclshapes.org/CorporationShape> a sh:NodeShape ;
    sh:property [ sh:datatype <rdf:langString> ;
            sh:path rdfs:comment ],
        [ sh:datatype <rdf:langString> ;
            sh:minCount 1 ;
            sh:path rdfs:label ],
        [ sh:datatype <xsd:decimal> ;
            sh:path yago:populationNumber ],
        [ sh:datatype <xsd:anyURI> ;
            sh:path schema:logo ],
        [ sh:datatype <xsd:anyURI> ;
            sh:path schema:image ],
        [ sh:datatype <rdf:langString> ;
            sh:path schema:alternateName ],
        [ sh:datatype <xsd:string> ;
            sh:path schema:duns ],
        [ sh:class schema:Person ;
            sh:path yago:leader ],
        [ sh:datatype <xsd:decimal> ;
            sh:path yago:length ],
        [ sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path owl:sameAs ],
        [ sh:class schema:Corporation ;
            sh:path yago:ownedBy ],
        [ sh:class schema:Corporation ;
            sh:path schema:memberOf ],
        [ sh:datatype <xsd:decimal> ;
            sh:path schema:numberOfEmployees ],
        [ sh:datatype <xsd:dateTime> ;
            sh:maxCount 1 ;
            sh:path schema:dissolutionDate ],
        [ sh:nodeKind sh:IRI ;
            sh:path yago:neighbors ],
        [ sh:nodeKind sh:IRI ;
            sh:path schema:location ],
        [ sh:minCount 1 ;
            sh:node <http://shaclshapes.org/CorporationShape> ;
            sh:path rdf:type ],
        [ sh:nodeKind sh:IRI ;
            sh:path schema:award ],
        [ sh:datatype <xsd:anyURI> ;
            sh:minCount 1 ;
            sh:path schema:mainEntityOfPage ],
        [ sh:datatype <xsd:dateTime> ;
            sh:maxCount 1 ;
            sh:path schema:dateCreated ],
        [ sh:datatype <xsd:string> ;
            sh:path schema:sameAs ],
        [ sh:datatype <xsd:decimal> ;
            sh:path yago:elevation ],
        [ sh:datatype <xsd:anyURI> ;
            sh:path schema:url ],
        [ sh:datatype <xsd:string> ;
            sh:path schema:slogan ],
        [ sh:datatype <xsd:string> ;
            sh:maxCount 1 ;
            sh:path schema:leiCode ],
        [ sh:datatype <xsd:string> ;
            sh:path schema:address ],
        [ sh:nodeKind sh:IRI ;
            sh:path schema:locationCreated ],
        [ sh:datatype <xsd:decimal> ;
            sh:path yago:area ],
        [ sh:class schema:Person ;
            sh:path schema:founder ],
        [ sh:datatype <geo:wktLiteral> ;
            sh:path schema:geo ] ;
    sh:targetClass schema:Corporation .

