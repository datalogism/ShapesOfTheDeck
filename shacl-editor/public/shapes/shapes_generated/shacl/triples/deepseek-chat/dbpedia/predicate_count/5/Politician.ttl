@prefix dbo: <http://dbpedia.org/ontology/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shapes: <http://example.org/shapes/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

shapes:PoliticianShape a sh:NodeShape ;
    sh:targetClass dbo:Politician ;
    sh:property [
        sh:path rdf:type ;
        sh:minCount 1 ;
        sh:hasValue dbo:Politician ;
        sh:nodeKind sh:IRI ;
    ] ;
    sh:property [
        sh:path dbo:termPeriod ;
        sh:minCount 1 ;
        sh:class dbo:Tenure ;
        sh:nodeKind sh:IRI ;
    ] ;
    sh:property [
        sh:path dbo:wikiPageRevisionID ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:nodeKind sh:Literal ;
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:datatype rdf:langString ;
        sh:nodeKind sh:Literal ;
    ] ;
    sh:property [
        sh:path rdfs:comment ;
        sh:minCount 1 ;
        sh:datatype rdf:langString ;
        sh:nodeKind sh:Literal ;
    ] ;
    sh:property [
        sh:path foaf:name ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:nodeKind sh:Literal ;
    ] ;
    sh:property [
        sh:path dbo:birthPlace ;
        sh:minCount 0 ;
        sh:class dbo:Place ;
        sh:nodeKind sh:IRI ;
    ] ;
    sh:property [
        sh:path dbo:party ;
        sh:minCount 1 ;
        sh:class dbo:PoliticalParty ;
        sh:nodeKind sh:IRI ;
    ] .