@prefix dbo: <http://dbpedia.org/ontology/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

shapes:CityShape a sh:NodeShape ;
    sh:targetClass dbo:City ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:nodeKind sh:Literal ;
        sh:datatype rdf:langString
    ], [
        sh:path foaf:name ;
        sh:minCount 1 ;
        sh:nodeKind sh:Literal ;
        sh:datatype xsd:string
    ], [
        sh:path dbo:wikiPageRevisionID ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:Literal ;
        sh:datatype xsd:integer
    ], [
        sh:path rdfs:comment ;
        sh:minCount 1 ;
        sh:nodeKind sh:Literal ;
        sh:datatype rdf:langString
    ], [
        sh:path dbo:country ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class dbo:Country
    ], [
        sh:path dbo:subdivision ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI
    ], [
        sh:path dbo:populationTotal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:Literal ;
        sh:datatype xsd:integer
    ], [
        sh:path dbo:utcOffset ;
        sh:nodeKind sh:Literal ;
        sh:datatype xsd:string
    ], [
        sh:path dbo:timeZone ;
        sh:nodeKind sh:IRI
    ], [
        sh:path dbo:elevation ;
        sh:nodeKind sh:Literal ;
        sh:datatype xsd:decimal
    ], [
        sh:path dbo:areaTotal ;
        sh:nodeKind sh:Literal ;
        sh:datatype xsd:decimal
    ], [
        sh:path dbo:postalCode ;
        sh:nodeKind sh:Literal ;
        sh:datatype xsd:string
    ], [
        sh:path dbo:areaCode ;
        sh:nodeKind sh:Literal ;
        sh:datatype xsd:string
    ], [
        sh:path dbo:type ;
        sh:nodeKind sh:IRI
    ], [
        sh:path foaf:homepage ;
        sh:nodeKind sh:IRI ;
        sh:datatype xsd:anyURI
    ], [
        sh:path dbo:originalName ;
        sh:nodeKind sh:Literal ;
        sh:datatype xsd:string
    ], [
        sh:path dbo:populationDensity ;
        sh:nodeKind sh:Literal ;
        sh:datatype xsd:decimal
    ], [
        sh:path dbo:areaLand ;
        sh:nodeKind sh:Literal ;
        sh:datatype xsd:decimal
    ], [
        sh:path dbo:areaWater ;
        sh:nodeKind sh:Literal ;
        sh:datatype xsd:decimal
    ], [
        sh:path foaf:nick ;
        sh:nodeKind sh:Literal ;
        sh:datatype xsd:string
    ], [
        sh:path dbo:demonym ;
        sh:nodeKind sh:Literal ;
        sh:datatype xsd:string
    ], [
        sh:path rdfs:seeAlso ;
        sh:nodeKind sh:IRI
    ], [
        sh:path dbo:populationMetro ;
        sh:nodeKind sh:Literal ;
        sh:datatype xsd:integer
    ], [
        sh:path dbo:foundingDate ;
        sh:nodeKind sh:Literal ;
        sh:datatype xsd:date
    ], [
        sh:path dbo:areaUrban ;
        sh:nodeKind sh:Literal ;
        sh:datatype xsd:decimal
    ], [
        sh:path dbo:governmentType ;
        sh:nodeKind sh:IRI
    ], [
        sh:path dbo:motto ;
        sh:nodeKind sh:Literal ;
        sh:datatype xsd:string
    ], [
        sh:path dbo:populationUrban ;
        sh:nodeKind sh:Literal ;
        sh:datatype xsd:integer
    ], [
        sh:path dbo:synonym ;
        sh:nodeKind sh:Literal ;
        sh:datatype xsd:string
    ], [
        sh:path dbo:namedAfter ;
        sh:nodeKind sh:IRI
    ], [
        sh:path dbo:politicalLeader ;
        sh:nodeKind sh:IRI
    ] .