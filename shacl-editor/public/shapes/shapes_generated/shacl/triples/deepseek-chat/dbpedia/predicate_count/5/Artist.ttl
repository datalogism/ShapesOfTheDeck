@prefix dbo: <http://dbpedia.org/ontology/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

shapes:ArtistShape a sh:NodeShape ;
    sh:targetClass dbo:Artist ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:nodeKind sh:Literal ;
        sh:datatype rdf:langString ;
    ] ;
    sh:property [
        sh:path rdfs:comment ;
        sh:minCount 1 ;
        sh:nodeKind sh:Literal ;
        sh:datatype rdf:langString ;
    ] ;
    sh:property [
        sh:path foaf:name ;
        sh:minCount 1 ;
        sh:nodeKind sh:Literal ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path foaf:givenName ;
        sh:nodeKind sh:Literal ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path dbo:wikiPageRevisionID ;
        sh:minCount 1 ;
        sh:nodeKind sh:Literal ;
        sh:datatype xsd:integer ;
    ] ;
    sh:property [
        sh:path dbo:birthDate ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:Literal ;
        sh:datatype xsd:date ;
    ] ;
    sh:property [
        sh:path dbo:birthYear ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:Literal ;
        sh:datatype xsd:gYear ;
    ] ;
    sh:property [
        sh:path dbo:birthPlace ;
        sh:nodeKind sh:IRI ;
        sh:class dbo:Place ;
    ] ;
    sh:property [
        sh:path dbo:deathDate ;
        sh:maxCount 1 ;
        sh:nodeKind sh:Literal ;
        sh:datatype xsd:date ;
    ] ;
    sh:property [
        sh:path dbo:deathYear ;
        sh:maxCount 1 ;
        sh:nodeKind sh:Literal ;
        sh:datatype xsd:gYear ;
    ] ;
    sh:property [
        sh:path dbo:deathPlace ;
        sh:nodeKind sh:IRI ;
        sh:class dbo:Place ;
    ] ;
    sh:property [
        sh:path dbo:activeYearsStartYear ;
        sh:nodeKind sh:Literal ;
        sh:datatype xsd:gYear ;
    ] ;
    sh:property [
        sh:path dbo:activeYearsEndYear ;
        sh:nodeKind sh:Literal ;
        sh:datatype xsd:gYear ;
    ] ;
    sh:property [
        sh:path dbo:genre ;
        sh:nodeKind sh:IRI ;
        sh:class dbo:Genre ;
    ] ;
    sh:property [
        sh:path dbo:occupation ;
        sh:nodeKind sh:IRI ;
        sh:class dbo:Occupation ;
    ] ;
    sh:property [
        sh:path dbo:instrument ;
        sh:nodeKind sh:IRI ;
        sh:class dbo:Instrument ;
    ] ;
    sh:property [
        sh:path dbo:recordLabel ;
        sh:nodeKind sh:IRI ;
        sh:class dbo:RecordLabel ;
    ] ;
    sh:property [
        sh:path dbo:associatedBand ;
        sh:nodeKind sh:IRI ;
        sh:class dbo:Band ;
    ] ;
    sh:property [
        sh:path dbo:associatedMusicalArtist ;
        sh:nodeKind sh:IRI ;
        sh:class dbo:MusicalArtist ;
    ] ;
    sh:property [
        sh:path dbo:hometown ;
        sh:nodeKind sh:IRI ;
        sh:class dbo:Place ;
    ] ;
    sh:property [
        sh:path dbo:alias ;
        sh:nodeKind sh:Literal ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path dbo:background ;
        sh:nodeKind sh:Literal ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path foaf:homepage ;
        sh:nodeKind sh:IRI ;
        sh:datatype xsd:anyURI ;
    ] .