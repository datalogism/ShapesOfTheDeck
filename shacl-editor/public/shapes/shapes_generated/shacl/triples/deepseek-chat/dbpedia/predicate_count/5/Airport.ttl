@prefix dbo: <http://dbpedia.org/ontology/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

shapes:AirportShape a sh:NodeShape ;
    sh:targetClass dbo:Airport ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:nodeKind sh:Literal ;
        sh:datatype rdf:langString
    ], [
        sh:path foaf:name ;
        sh:minCount 1 ;
        sh:nodeKind sh:Literal ;
        sh:datatype xsd:string
    ], [
        sh:path dbo:wikiPageRevisionID ;
        sh:minCount 1 ;
        sh:nodeKind sh:Literal ;
        sh:datatype xsd:integer
    ], [
        sh:path rdfs:comment ;
        sh:minCount 1 ;
        sh:nodeKind sh:Literal ;
        sh:datatype rdf:langString
    ], [
        sh:path dbo:elevation ;
        sh:nodeKind sh:Literal ;
        sh:datatype xsd:double
    ], [
        sh:path dbo:runwayLength ;
        sh:nodeKind sh:Literal ;
        sh:datatype xsd:double
    ], [
        sh:path dbo:runwayDesignation ;
        sh:nodeKind sh:Literal ;
        sh:datatype xsd:string
    ], [
        sh:path dbo:runwaySurface ;
        sh:nodeKind sh:Literal ;
        sh:datatype xsd:string
    ], [
        sh:path dbo:city ;
        sh:nodeKind sh:IRI ;
        sh:class dbo:Settlement
    ], [
        sh:path dbo:icaoLocationIdentifier ;
        sh:nodeKind sh:Literal ;
        sh:datatype xsd:string
    ], [
        sh:path dbo:iataLocationIdentifier ;
        sh:nodeKind sh:Literal ;
        sh:datatype xsd:string
    ], [
        sh:path dbo:location ;
        sh:nodeKind sh:IRI ;
        sh:class dbo:Place
    ], [
        sh:path foaf:homepage ;
        sh:nodeKind sh:IRI ;
        sh:datatype xsd:anyURI
    ], [
        sh:path dbo:owner ;
        sh:nodeKind sh:IRI ;
        sh:class dbo:Organisation
    ], [
        sh:path dbo:operator ;
        sh:nodeKind sh:IRI ;
        sh:class dbo:Organisation
    ], [
        sh:path dbo:faaLocationIdentifier ;
        sh:nodeKind sh:Literal ;
        sh:datatype xsd:string
    ] .