@prefix dbo: <http://dbpedia.org/ontology/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shapes: <http://shaclshapes.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

shapes:MonumentShape a sh:NodeShape ;
    sh:targetClass dbo:Monument ;
    
    sh:property [
        sh:path rdf:type ;
        sh:hasValue dbo:Monument ;
    ] ;
    
    sh:property [
        sh:path foaf:name ;
        sh:datatype rdf:langString ;
        sh:minCount 1 ;
    ] ;
    
    sh:property [
        sh:path dbo:location ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
    ] ;
    
    sh:property [
        sh:path dbo:designer ;
        sh:nodeKind sh:IRI ;
        sh:maxCount 1 ;
    ] ;
    
    sh:property [
        sh:path <http://www.w3.org/ns/dcat#resource_identifier> ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    
    sh:property [
        sh:path dbo:architecturalStyle ;
        sh:nodeKind sh:IRI ;
        sh:maxCount 1 ;
    ] ;
    
    sh:property [
        sh:path dbo:constructed ;
        sh:datatype xsd:gYear ;
        sh:maxCount 1 ;
    ] ;
    
    sh:property [
        sh:path dbo:material ;
        sh:nodeKind sh:IRI ;
        sh:maxCount 1 ;
    ] ;
    
    sh:property [
        sh:path dbo:inscription ;
        sh:datatype rdf:langString ;
        sh:maxCount 1 ;
    ] ;
    
    sh:property [
        sh:path dbo:height ;
        sh:datatype xsd:float ;
        sh:maxCount 1 ;
    ] ;
    
    sh:property [
        sh:path dbo:width ;
        sh:datatype xsd:float ;
        sh:maxCount 1 ;
    ] ;
    
    sh:property [
        sh:path dbo:length ;
        sh:datatype xsd:float ;
        sh:maxCount 1 ;
    ] ;
    
    sh:property [
        sh:path dbo:area ;
        sh:datatype xsd:float ;
        sh:maxCount 1 ;
    ] ;
    
    sh:property [
        sh:path dbo:heritageDesignation ;
        sh:nodeKind sh:IRI ;
        sh:maxCount 1 ;
    ] .