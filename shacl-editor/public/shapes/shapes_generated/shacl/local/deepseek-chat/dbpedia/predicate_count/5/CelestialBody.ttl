@prefix dbo: <http://dbpedia.org/ontology/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shapes: <http://shaclshapes.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

shapes:CelestialBodyShape a sh:NodeShape ;
    sh:targetClass dbo:CelestialBody ;
    sh:property [
        sh:path foaf:name ;
        sh:minCount 1 ;
        sh:datatype rdf:langString ;
        sh:nodeKind sh:Literal ;
    ] ;
    sh:property [
        sh:path dbo:absoluteMagnitude ;
        sh:datatype xsd:decimal ;
        sh:nodeKind sh:Literal ;
    ] ;
    sh:property [
        sh:path dbo:albedo ;
        sh:datatype xsd:decimal ;
        sh:nodeKind sh:Literal ;
    ] ;
    sh:property [
        sh:path dbo:apoapsis ;
        sh:datatype xsd:decimal ;
        sh:nodeKind sh:Literal ;
    ] ;
    sh:property [
        sh:path dbo:periapsis ;
        sh:datatype xsd:decimal ;
        sh:nodeKind sh:Literal ;
    ] ;
    sh:property [
        sh:path dbo:orbitalPeriod ;
        sh:datatype xsd:decimal ;
        sh:nodeKind sh:Literal ;
    ] ;
    sh:property [
        sh:path dbo:rotationPeriod ;
        sh:datatype xsd:decimal ;
        sh:nodeKind sh:Literal ;
    ] ;
    sh:property [
        sh:path dbo:averageSpeed ;
        sh:datatype xsd:decimal ;
        sh:nodeKind sh:Literal ;
    ] ;
    sh:property [
        sh:path dbo:mass ;
        sh:datatype xsd:decimal ;
        sh:nodeKind sh:Literal ;
    ] ;
    sh:property [
        sh:path dbo:escapeVelocity ;
        sh:datatype xsd:decimal ;
        sh:nodeKind sh:Literal ;
    ] ;
    sh:property [
        sh:path dbo:density ;
        sh:datatype xsd:decimal ;
        sh:nodeKind sh:Literal ;
    ] ;
    sh:property [
        sh:path dbo:temperature ;
        sh:datatype xsd:decimal ;
        sh:nodeKind sh:Literal ;
    ] ;
    sh:property [
        sh:path dbo:meanTemperature ;
        sh:datatype xsd:decimal ;
        sh:nodeKind sh:Literal ;
    ] ;
    sh:property [
        sh:path dbo:minimumTemperature ;
        sh:datatype xsd:decimal ;
        sh:nodeKind sh:Literal ;
    ] ;
    sh:property [
        sh:path dbo:apparentMagnitude ;
        sh:datatype xsd:decimal ;
        sh:nodeKind sh:Literal ;
    ] ;
    sh:property [
        sh:path dbo:volume ;
        sh:datatype xsd:decimal ;
        sh:nodeKind sh:Literal ;
    ] ;
    sh:property [
        sh:path dbo:surfaceArea ;
        sh:datatype xsd:decimal ;
        sh:nodeKind sh:Literal ;
    ] ;
    sh:property [
        sh:path dbo:meanRadius ;
        sh:datatype xsd:decimal ;
        sh:nodeKind sh:Literal ;
    ] ;
    sh:property [
        sh:path dbo:discovered ;
        sh:datatype xsd:date ;
        sh:nodeKind sh:Literal ;
    ] ;
    sh:property [
        sh:path dbo:epoch ;
        sh:datatype xsd:string ;
        sh:nodeKind sh:Literal ;
    ] ;
    sh:property [
        sh:path dbo:formerName ;
        sh:datatype xsd:string ;
        sh:nodeKind sh:Literal ;
    ] ;
    sh:property [
        sh:path dbo:discoverer ;
        sh:class dbo:Person ;
        sh:nodeKind sh:IRI ;
    ] .