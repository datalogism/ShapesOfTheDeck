@prefix dbo: <http://dbpedia.org/ontology/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shapes: <http://shaclshapes.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

shapes:CityShape a sh:NodeShape ;
    sh:targetClass dbo:City ;
    sh:property [
        sh:path foaf:name ;
        sh:datatype rdf:langString ;
        sh:minCount 1 ;
        sh:maxCount 2 ;
        sh:nodeKind sh:Literal ;
    ], [
        sh:path dbo:areaTotal ;
        sh:datatype xsd:float ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:Literal ;
    ], [
        sh:path dbo:foundingDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 2 ;
        sh:nodeKind sh:Literal ;
    ], [
        sh:path dbo:populationTotal ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:Literal ;
    ], [
        sh:path dbo:elevation ;
        sh:datatype xsd:float ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:Literal ;
    ], [
        sh:path dbo:utcOffset ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 2 ;
        sh:nodeKind sh:Literal ;
    ], [
        sh:path dbo:areaCode ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:Literal ;
    ], [
        sh:path dbo:postalCode ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 10 ;
        sh:nodeKind sh:Literal ;
    ], [
        sh:path dbo:demonym ;
        sh:datatype rdf:langString ;
        sh:minCount 1 ;
        sh:maxCount 2 ;
        sh:nodeKind sh:Literal ;
    ], [
        sh:path dbo:motto ;
        sh:datatype rdf:langString ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:Literal ;
    ], [
        sh:path dbo:populationDensity ;
        sh:datatype xsd:float ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:Literal ;
    ], [
        sh:path dbo:governingBody ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ], [
        sh:path dbo:governmentType ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ], [
        sh:path dbo:timeZone ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 2 ;
    ], [
        sh:path dbo:namedAfter ;
        sh:nodeKind sh:IRI ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
    ], [
        sh:path dbo:homepage ;
        sh:datatype xsd:anyURI ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
    ], [
        sh:path dbo:subdivision ;
        sh:nodeKind sh:IRI ;
        sh:minCount 0 ;
        sh:maxCount 10 ;
    ], [
        sh:path dbo:politicalLeader ;
        sh:nodeKind sh:IRI ;
        sh:minCount 0 ;
        sh:maxCount 5 ;
    ], [
        sh:path dbo:type ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] .