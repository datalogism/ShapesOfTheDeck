@prefix dbo: <http://dbpedia.org/ontology/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shapes: <http://shaclshapes.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

shapes:ComicsCharacterShape a sh:NodeShape ;
    sh:targetClass dbo:ComicsCharacter ;
    
    sh:property [
        sh:path foaf:name ;
        sh:datatype rdf:langString ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    
    sh:property [
        sh:path foaf:givenName ;
        sh:datatype rdf:langString ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    
    sh:property [
        sh:path dbo:alias ;
        sh:datatype rdf:langString ;
        sh:minCount 0 ;
        sh:maxCount 10 ;
    ] ;
    
    sh:property [
        sh:path dbo:firstAppearance ;
        sh:datatype rdf:langString ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    
    sh:property [
        sh:path dbo:lastAppearance ;
        sh:datatype rdf:langString ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
    ] ;
    
    sh:property [
        sh:path dbo:creator ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 10 ;
    ] ;
    
    sh:property [
        sh:path dbo:voice ;
        sh:nodeKind sh:IRI ;
        sh:minCount 0 ;
        sh:maxCount 10 ;
    ] ;
    
    sh:property [
        sh:path dbo:species ;
        sh:nodeKind sh:IRI ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
    ] ;
    
    sh:property [
        sh:path dbo:gender ;
        sh:nodeKind sh:IRI ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
    ] ;
    
    sh:property [
        sh:path <http://www.w3.org/ns/dcat#resource_identifier> ;
        sh:datatype xsd:string ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
    ] ;
    
    sh:property [
        sh:path dbo:child ;
        sh:nodeKind sh:IRI ;
        sh:minCount 0 ;
        sh:maxCount 10 ;
    ] ;
    
    sh:property [
        sh:path dbo:relative ;
        sh:nodeKind sh:IRI ;
        sh:minCount 0 ;
        sh:maxCount 10 ;
    ] ;
    
    sh:property [
        sh:path dbo:imdbId ;
        sh:datatype xsd:string ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
    ] ;
    
    sh:property [
        sh:path dbo:portrayer ;
        sh:nodeKind sh:IRI ;
        sh:minCount 0 ;
        sh:maxCount 10 ;
    ] .