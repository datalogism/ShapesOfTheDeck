@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <http://schema.org/> .
@prefix yago: <http://yago-knowledge.org/resource/> .

<http://shaclshapes.org/EventShape> a sh:NodeShape ;
    sh:targetClass schema:Event ;
    sh:property [
        sh:path rdf:type ;
        sh:hasValue schema:Event ;
        sh:minCount 1
    ] ,
    [
        sh:path rdfs:label ;
        sh:datatype rdf:langString ;
        sh:minCount 1
    ] ,
    [
        sh:path rdfs:comment ;
        sh:datatype rdf:langString ;
        sh:minCount 0
    ] ,
    [
        sh:path schema:startDate ;
        sh:datatype xsd:dateTime ;
        sh:minCount 0 ;
        sh:maxCount 1
    ] ,
    [
        sh:path schema:endDate ;
        sh:datatype xsd:dateTime ;
        sh:minCount 0 ;
        sh:maxCount 1
    ] ,
    [
        sh:path schema:location ;
        sh:class schema:Place ;
        sh:minCount 0
    ] ,
    [
        sh:path schema:image ;
        sh:datatype xsd:anyURI ;
        sh:minCount 0
    ] ,
    [
        sh:path schema:mainEntityOfPage ;
        sh:datatype xsd:anyURI ;
        sh:minCount 0
    ] ,
    [
        sh:path schema:alternateName ;
        sh:datatype rdf:langString ;
        sh:minCount 0
    ] ,
    [
        sh:path schema:sameAs ;
        sh:datatype xsd:anyURI ;
        sh:minCount 0
    ] ,
    [
        sh:path schema:organizer ;
        sh:class schema:Organization ;
        sh:minCount 0
    ] ,
    [
        sh:path schema:superEvent ;
        sh:class schema:Event ;
        sh:minCount 0
    ] ,
    [
        sh:path yago:follows ;
        sh:class schema:Event ;
        sh:minCount 0
    ] ,
    [
        sh:path yago:precedes ;
        sh:class schema:Event ;
        sh:minCount 0
    ] .