@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<file:///C:/Users/doccr/PycharmProjects/DoubleShapespresso/Food> a sh:NodeShape ;
    sh:property [ sh:datatype rdf:langString ;
            sh:minCount 0 ;
            sh:path dbo:alias ],
        [ sh:class dbo:Food ;
            sh:minCount 1 ;
            sh:path dbo:country ],
        [ sh:class dbo:Food ;
            sh:minCount 0 ;
            sh:path dbo:creatorOfDish ],
        [ sh:datatype xsd:string ;
            sh:minCount 0 ;
            sh:path dbo:cuisine ],
        [ sh:class dbo:Food ;
            sh:minCount 1 ;
            sh:path dbo:ingredient ],
        [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path dbo:ingredientName ],
        [ sh:class dbo:Food ;
            sh:minCount 1 ;
            sh:path dbo:manufacturer ],
        [ sh:class dbo:Food ;
            sh:minCount 0 ;
            sh:path dbo:origin ],
        [ sh:class dbo:Food ;
            sh:minCount 0 ;
            sh:path dbo:region ],
        [ sh:class dbo:Food ;
            sh:minCount 0 ;
            sh:path dbo:related ],
        [ sh:datatype xsd:double ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:path dbo:servingSize ],
        [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path dbo:servingTemperature ],
        [ sh:class dbo:Food ;
            sh:minCount 1 ;
            sh:path dbo:type ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path dbo:wikiPageRevisionID ],
        [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path dc:type ],
        [ sh:class dbo:Food ;
            sh:minCount 0 ;
            sh:path foaf:homepage ],
        [ sh:datatype rdf:langString ;
            sh:maxCount 3 ;
            sh:minCount 1 ;
            sh:path foaf:name ],
        [ sh:datatype xsd:double ;
            sh:minCount 1 ;
            sh:path dcat:resource_identifier ],
        [ sh:class dbo:Food ;
            sh:minCount 1 ;
            sh:path rdf:type ],
        [ sh:datatype rdf:langString ;
            sh:maxCount 2 ;
            sh:minCount 1 ;
            sh:path rdfs:comment ],
        [ sh:datatype rdf:langString ;
            sh:minCount 1 ;
            sh:path rdfs:label ] ;
    sh:targetClass dbo:Food .

