@prefix dbo: <http://dbpedia.org/ontology/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<file:///C:/Users/doccr/PycharmProjects/DoubleShapespresso/Astronaut> a sh:NodeShape ;
    sh:property [ sh:class dbo:Organisation ;
            sh:minCount 0 ;
            sh:path dbo:almaMater ],
        [ sh:class dbo:Award ;
            sh:minCount 0 ;
            sh:path dbo:award ],
        [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:path dbo:birthDate ],
        [ sh:datatype rdf:langString ;
            sh:minCount 0 ;
            sh:path dbo:birthName ],
        [ sh:class dbo:Place ;
            sh:minCount 0 ;
            sh:path dbo:birthPlace ],
        [ sh:datatype xsd:integer ;
            sh:minCount 0 ;
            sh:path dbo:birthYear ],
        [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:path dbo:deathDate ],
        [ sh:class dbo:Place ;
            sh:minCount 0 ;
            sh:path dbo:deathPlace ],
        [ sh:datatype xsd:integer ;
            sh:minCount 0 ;
            sh:path dbo:deathYear ],
        [ sh:class dbo:Mission ;
            sh:minCount 0 ;
            sh:path dbo:mission ],
        [ sh:class dbo:Place ;
            sh:minCount 0 ;
            sh:path dbo:nationality ],
        [ sh:class owl:Thing ;
            sh:minCount 0 ;
            sh:path dbo:occupation ],
        [ sh:class owl:Thing ;
            sh:minCount 0 ;
            sh:path dbo:selection ],
        [ sh:datatype xsd:string ;
            sh:minCount 0 ;
            sh:path dbo:status ],
        [ sh:datatype xsd:double ;
            sh:minCount 0 ;
            sh:path dbo:timeInSpace ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:path dbo:wikiPageRevisionID ],
        [ sh:datatype rdf:langString ;
            sh:minCount 0 ;
            sh:path foaf:name ],
        [ sh:datatype xsd:double ;
            sh:minCount 0 ;
            sh:path dcat:resource_identifier ],
        [ sh:class dbo:Astronaut ;
            sh:minCount 1 ;
            sh:path rdf:type ],
        [ sh:datatype rdf:langString ;
            sh:minCount 0 ;
            sh:path rdfs:comment ],
        [ sh:datatype rdf:langString ;
            sh:minCount 0 ;
            sh:path rdfs:label ] ;
    sh:targetClass dbo:Astronaut .

