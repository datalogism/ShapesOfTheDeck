@prefix dbo: <http://dbpedia.org/ontology/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<file:///C:/Users/doccr/PycharmProjects/DoubleShapespresso/University> a sh:NodeShape ;
    sh:property [ sh:class dbo:Organisation ;
            sh:minCount 0 ;
            sh:path dbo:affiliation ],
        [ sh:class dbo:Place ;
            sh:minCount 0 ;
            sh:path dbo:campus ],
        [ sh:minCount 0 ;
            sh:or ( [ sh:class dbo:Person ] [ sh:class dbo:Animal ] [ sh:class dbo:Eukaryote ] ) ;
            sh:path dbo:chancellor ],
        [ sh:class dbo:Place ;
            sh:minCount 0 ;
            sh:path dbo:city ],
        [ sh:class dbo:Country ;
            sh:minCount 0 ;
            sh:path dbo:country ],
        [ sh:class owl:Thing ;
            sh:minCount 0 ;
            sh:path dbo:dean ],
        [ sh:datatype xsd:integer ;
            sh:minCount 0 ;
            sh:path dbo:facultySize ],
        [ sh:datatype rdf:langString ;
            sh:minCount 0 ;
            sh:path dbo:formerName ],
        [ sh:datatype xsd:date ;
            sh:minCount 0 ;
            sh:path dbo:foundingDate ],
        [ sh:datatype xsd:string ;
            sh:minCount 0 ;
            sh:path dbo:motto ],
        [ sh:datatype xsd:integer ;
            sh:minCount 0 ;
            sh:path dbo:numberOfPostgraduateStudents ],
        [ sh:datatype xsd:integer ;
            sh:minCount 0 ;
            sh:path dbo:numberOfStudents ],
        [ sh:datatype xsd:integer ;
            sh:minCount 0 ;
            sh:path dbo:numberOfUndergraduateStudents ],
        [ sh:datatype xsd:string ;
            sh:minCount 0 ;
            sh:path dbo:officialSchoolColour ],
        [ sh:minCount 0 ;
            sh:or ( [ sh:class dbo:Animal ] [ sh:class dbo:Eukaryote ] [ sh:class owl:Thing ] ) ;
            sh:path dbo:president ],
        [ sh:class dbo:Person ;
            sh:minCount 0 ;
            sh:path dbo:rector ],
        [ sh:class dbo:Place ;
            sh:minCount 0 ;
            sh:path dbo:state ],
        [ sh:class owl:Thing ;
            sh:minCount 0 ;
            sh:path dbo:type ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path dbo:wikiPageRevisionID ],
        [ sh:datatype sh:IRI ;
            sh:minCount 0 ;
            sh:path foaf:homepage ],
        [ sh:datatype rdf:langString ;
            sh:minCount 0 ;
            sh:path foaf:name ],
        [ sh:datatype xsd:double ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:path dcat:resource_identifier ],
        [ sh:class dbo:University ;
            sh:maxCount 15 ;
            sh:minCount 14 ;
            sh:path rdf:type ],
        [ sh:datatype rdf:langString ;
            sh:minCount 0 ;
            sh:path rdfs:comment ],
        [ sh:datatype rdf:langString ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path rdfs:label ] ;
    sh:targetClass dbo:University .

