<file:///C:/Users/doccr/PycharmProjects/DoubleShapespresso/Politician> a sh:NodeShape ;
    sh:property [ sh:datatype sh:IRI ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path owl:sameAs ],
        [ sh:class yago:Politician ;
