<file:///C:/Users/doccr/PycharmProjects/DoubleShapespresso/City> a sh:NodeShape ;
    sh:property [ sh:class schema1:City ;
            sh:minCount 1 ;
            sh:path owl:sameAs ],
        [ sh:minCount 1 ;
            sh:or ( [ sh:class schema1:City ] [ sh:class yago:Unincorporated_Community_In_The_United_States_Q17343829 ] [ sh:class yago:Gmina ] ) ;
            sh:path rdf:type ],
