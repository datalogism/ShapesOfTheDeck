@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <http://schema.org/> .
@prefix yago: <http://yago-knowledge.org/resource/> .

<http://shaclshapes.org/AirlineShape> a sh:NodeShape ;
    sh:targetClass schema:Airline ;
    sh:property [
        sh:path rdf:type ;
        sh:hasValue schema:Airline ;
        sh:minCount 1
    ] ,
    [
        sh:path rdfs:label ;
        sh:datatype rdf:langString ;
        sh:minCount 1
    ] ,
    [
        sh:path rdfs:comment ;
        sh:datatype rdf:langString ;
        sh:minCount 1
    ] ,
    [
        sh:path schema:address ;
        sh:datatype xsd:string ;
        sh:minCount 0 ;
        sh:maxCount 1
    ] ,
    [
        sh:path schema:alternateName ;
        sh:datatype rdf:langString ;
        sh:minCount 0
    ] ,
    [
        sh:path schema:dateCreated ;
        sh:datatype xsd:dateTime ;
        sh:minCount 0 ;
        sh:maxCount 1
    ] ,
    [
        sh:path schema:iataCode ;
        sh:datatype xsd:string ;
        sh:minCount 0 ;
        sh:maxCount 1
    ] ,
    [
        sh:path schema:icaoCode ;
        sh:datatype xsd:string ;
        sh:minCount 0 ;
        sh:maxCount 1
    ] ,
    [
        sh:path schema:image ;
        sh:datatype xsd:anyURI ;
        sh:minCount 0
    ] ,
    [
        sh:path schema:leiCode ;
        sh:datatype xsd:string ;
        sh:minCount 0 ;
        sh:maxCount 1
    ] ,
    [
        sh:path schema:location ;
        sh:class schema:Place ;
        sh:minCount 0
    ] ,
    [
        sh:path schema:locationCreated ;
        sh:class schema:Place ;
        sh:minCount 0 ;
        sh:maxCount 1
    ] ,
    [
        sh:path schema:logo ;
        sh:datatype xsd:anyURI ;
        sh:minCount 0
    ] ,
    [
        sh:path schema:mainEntityOfPage ;
        sh:datatype xsd:anyURI ;
        sh:minCount 0
    ] ,
    [
        sh:path schema:memberOf ;
        sh:class schema:Organization ;
        sh:minCount 0
    ] ,
    [
        sh:path schema:numberOfEmployees ;
        sh:datatype xsd:decimal ;
        sh:minCount 0 ;
        sh:maxCount 1
    ] ,
    [
        sh:path schema:sameAs ;
        sh:datatype xsd:string ;
        sh:minCount 0
    ] ,
    [
        sh:path schema:slogan ;
        sh:datatype xsd:string ;
        sh:minCount 0
    ] ,
    [
        sh:path schema:url ;
        sh:datatype xsd:anyURI ;
        sh:minCount 0
    ] .