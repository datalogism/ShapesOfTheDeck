@prefix dbo: <http://dbpedia.org/ontology/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shapes: <http://shaclshapes.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

shapes:WrittenWorkShape a sh:NodeShape ;
    sh:targetClass dbo:WrittenWork ;
    
    sh:property [
        sh:path foaf:name ;
        sh:datatype rdf:langString ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    
    sh:property [
        sh:path dbo:releaseDate ;
        sh:datatype xsd:date ;
        sh:maxCount 1 ;
    ] ;
    
    sh:property [
        sh:path dbo:isbn ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    
    sh:property [
        sh:path dbo:lcc ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    
    sh:property [
        sh:path dbo:numberOfPages ;
        sh:datatype xsd:integer ;
        sh:maxCount 1 ;
    ] ;
    
    sh:property [
        sh:path dbo:oclc ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    
    sh:property [
        sh:path dc:publisher ;
        sh:datatype rdf:langString ;
        sh:maxCount 1 ;
    ] ;
    
    sh:property [
        sh:path dbo:country ;
        sh:nodeKind sh:IRI ;
        sh:maxCount 1 ;
    ] ;
    
    sh:property [
        sh:path dbo:author ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
    ] ;
    
    sh:property [
        sh:path dbo:coverArtist ;
        sh:nodeKind sh:IRI ;
        sh:maxCount 1 ;
    ] ;
    
    sh:property [
        sh:path dbo:illustrator ;
        sh:nodeKind sh:IRI ;
        sh:maxCount 1 ;
    ] ;
    
    sh:property [
        sh:path dbo:previousWork ;
        sh:nodeKind sh:IRI ;
        sh:maxCount 1 ;
    ] ;
    
    sh:property [
        sh:path dbo:subsequentWork ;
        sh:nodeKind sh:IRI ;
        sh:maxCount 1 ;
    ] ;
    
    sh:property [
        sh:path dbo:language ;
        sh:nodeKind sh:IRI ;
        sh:maxCount 1 ;
    ] ;
    
    sh:property [
        sh:path dbo:literaryGenre ;
        sh:nodeKind sh:IRI ;
        sh:maxCount 1 ;
    ] ;
    
    sh:property [
        sh:path dbo:mediaType ;
        sh:nodeKind sh:IRI ;
        sh:maxCount 1 ;
    ] ;
    
    sh:property [
        sh:path dbo:series ;
        sh:nodeKind sh:IRI ;
        sh:maxCount 1 ;
    ] ;
    
    sh:property [
        sh:path <http://www.w3.org/ns/dcat#resource_identifier> ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] .