@prefix dbo: <http://dbpedia.org/ontology/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

shapes:AirportShape a sh:NodeShape ;
    sh:targetClass dbo:Airport ;
    sh:property [
        sh:path foaf:name ;
        sh:minCount 1 ;
        sh:nodeKind sh:Literal ;
        sh:datatype rdf:langString ;
    ] ;
    sh:property [
        sh:path dbo:elevation ;
        sh:nodeKind sh:Literal ;
        sh:datatype xsd:double ;
    ] ;
    sh:property [
        sh:path dbo:runwayDesignation ;
        sh:nodeKind sh:Literal ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path dbo:runwayLength ;
        sh:nodeKind sh:Literal ;
        sh:datatype xsd:double ;
    ] ;
    sh:property [
        sh:path dbo:runwaySurface ;
        sh:nodeKind sh:Literal ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path dbo:icaoLocationIdentifier ;
        sh:nodeKind sh:Literal ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path dbo:iataLocationIdentifier ;
        sh:nodeKind sh:Literal ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path dbo:faaLocationIdentifier ;
        sh:nodeKind sh:Literal ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path dbo:locationIdentifier ;
        sh:nodeKind sh:Literal ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path dbo:owner ;
        sh:nodeKind sh:IRI ;
        sh:class dbo:Organisation ;
    ] ;
    sh:property [
        sh:path dbo:location ;
        sh:nodeKind sh:IRI ;
        sh:class dbo:Place ;
    ] ;
    sh:property [
        sh:path dbo:city ;
        sh:nodeKind sh:IRI ;
        sh:class dbo:Settlement ;
    ] ;
    sh:property [
        sh:path foaf:homepage ;
        sh:nodeKind sh:IRI ;
        sh:datatype xsd:anyURI ;
    ] ;
    sh:property [
        sh:path dbo:operator ;
        sh:nodeKind sh:IRI ;
        sh:class dbo:Organisation ;
    ] ;
    sh:property [
        sh:path dbo:type ;
        sh:nodeKind sh:IRI ;
        sh:class dbo:Airport ;
    ] .