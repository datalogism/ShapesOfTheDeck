        sh:path dbo:numberOfHalfCenturies ;
        sh:nodeKind sh:Literal ;
        sh:datatype xsd:integer
    ], [
        sh:path dbo:numberOfDucks ;
        sh:nodeKind sh:Literal ;
        sh:datatype xsd:integer
    ], [
        sh:path dbo:numberOfFours ;
        sh:nodeKind sh:Literal ;
        sh:datatype xsd:integer
    ], [
        sh:path dbo:numberOfSixes ;
        sh:nodeKind sh:Literal ;
        sh:datatype xsd:integer
    ], [
        sh:path dbo:numberOfHatTricks ;
        sh:nodeKind sh:Literal ;
        sh:datatype xsd:integer
    ], [
        sh:path dbo:numberOfFiveWicketHauls ;
        sh:nodeKind sh:Literal ;
        sh:datatype xsd:integer
    ], [
        sh:path dbo:numberOfTenWicketHauls ;
        sh:nodeKind sh:Literal ;
        sh:datatype xsd:integer
    ], [
        sh:path dbo:numberOfMatches ;
        sh:nodeKind sh:Literal ;
        sh:datatype xsd:integer
    ], [
        sh:path dbo:numberOfInnings ;
        sh:nodeKind sh:Literal ;
        sh:datatype xsd:integer
    ], [
        sh:path dbo:numberOfNotOuts ;
        sh:nodeKind sh:Literal ;
        sh:datatype xsd:integer
    ], [
        sh:path dbo:numberOfBallsFaced ;
        sh:nodeKind sh:Literal ;
        sh:datatype xsd:integer
    ], [
        sh:path dbo:numberOfBallsBowled ;
        sh:nodeKind sh:Literal ;
        sh:datatype xsd:integer
    ], [
        sh:path dbo:numberOfMaidens ;
        sh:nodeKind sh:Literal ;
        sh:datatype xsd:integer
    ], [
        sh:path dbo:numberOfOvers ;
        sh:nodeKind sh:Literal ;
