@prefix dbo: <http://dbpedia.org/ontology/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shapes: <http://shaclshapes.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

shapes:SportsTeamShape a sh:NodeShape ;
    sh:targetClass dbo:SportsTeam ;
    sh:property [
        sh:path foaf:name ;
        sh:minCount 1 ;
        sh:nodeKind sh:Literal ;
        sh:datatype rdf:langString
    ], [
        sh:path dbo:foundingYear ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:Literal ;
        sh:datatype xsd:gYear
    ], [
        sh:path dbo:dissolutionYear ;
        sh:maxCount 1 ;
        sh:nodeKind sh:Literal ;
        sh:datatype xsd:gYear
    ], [
        sh:path foaf:nick ;
        sh:nodeKind sh:Literal ;
        sh:datatype rdf:langString
    ], [
        sh:path dbo:capacity ;
        sh:nodeKind sh:Literal ;
        sh:datatype xsd:integer
    ], [
        sh:path dbo:owner ;
        sh:nodeKind sh:IRI ;
        sh:class dbo:Organisation
    ], [
        sh:path dbo:location ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class dbo:Place
    ], [
        sh:path dbo:manager ;
        sh:nodeKind sh:IRI ;
        sh:class dbo:Person
    ], [
        sh:path dbo:league ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class dbo:SportsLeague
    ], [
        sh:path dbo:stadium ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class dbo:Stadium
    ], [
        sh:path dbo:president ;
        sh:nodeKind sh:IRI ;
        sh:class dbo:Person
    ], [
        sh:path foaf:homepage ;
        sh:nodeKind sh:IRI ;
        sh:datatype xsd:anyURI
    ], [
        sh:path dbo:coach ;
        sh:nodeKind sh:IRI ;
        sh:class dbo:Person
    ], [
        sh:path dbo:teamCaptain ;
        sh:nodeKind sh:IRI ;
        sh:class dbo:Person
    ], [
        sh:path dbo:ground ;
        sh:nodeKind sh:IRI ;
        sh:class dbo:Stadium
    ], [
        sh:path dbo:teamColour ;
        sh:nodeKind sh:Literal ;
        sh:datatype xsd:string
    ], [
        sh:path dbo:sponsor ;
        sh:nodeKind sh:IRI ;
        sh:class dbo:Organisation
    ], [
        sh:path dbo:championship ;
        sh:nodeKind sh:IRI ;
        sh:class dbo:SportsEvent
    ], [
        sh:path dbo:division ;
        sh:nodeKind sh:IRI ;
        sh:class dbo:SportsLeague
    ], [
        sh:path dbo:team ;
        sh:nodeKind sh:IRI ;
        sh:class dbo:SportsTeam
    ], [
        sh:path dbo:activeYearsStartYear ;
        sh:nodeKind sh:Literal ;
        sh:datatype xsd:gYear
    ], [
        sh:path dbo:activeYearsEndYear ;
        sh:nodeKind sh:Literal ;
        sh:datatype xsd:gYear
    ], [
        sh:path dbo:regionServed ;
        sh:nodeKind sh:IRI ;
        sh:class dbo:Place
    ], [
        sh:path dbo:affiliation ;
        sh:nodeKind sh:IRI ;
        sh:class dbo:Organisation
    ], [
        sh:path dbo:parentOrganisation ;
        sh:nodeKind sh:IRI ;
        sh:class dbo:Organisation
    ], [
        sh:path dbo:subsidiary ;
        sh:nodeKind sh:IRI ;
        sh:class dbo:Organisation
    ], [
        sh:path dbo:numberOfPlayers ;
        sh:nodeKind sh:Literal ;
        sh:datatype xsd:integer
    ], [
        sh:path dbo:numberOfSeasons ;
        sh:nodeKind sh:Literal ;
        sh:datatype xsd:integer
    ], [
        sh:path dbo:numberOfWins ;
        sh:nodeKind sh:Literal ;
        sh:datatype xsd:integer
    ], [
        sh:path dbo:numberOfLosses ;
        sh:nodeKind sh:Literal ;
        sh:datatype xsd:integer
    ], [
        sh:path dbo:numberOfDraws ;
        sh:nodeKind sh:Literal ;
        sh:datatype xsd:integer
    ], [
        sh:path dbo:numberOfPoints ;
        sh:nodeKind sh:Literal ;
        sh:datatype xsd:integer
    ], [
        sh:path dbo:numberOfGoals ;
        sh:nodeKind sh:Literal ;
        sh:datatype xsd:integer
    ], [
        sh:path dbo:numberOfTitles ;
        sh:nodeKind sh:Literal ;
        sh:datatype xsd:integer
    ], [
        sh:path dbo:numberOfRuns ;
        sh:nodeKind sh:Literal ;
        sh:datatype xsd:integer
