    ], [
        sh:path dbo:numberOfBallsFacedBatted ;
        sh:nodeKind sh:Literal ;
        sh:datatype xsd:integer
    ], [
        sh:path dbo:numberOfBallsBowledBowled ;
        sh:nodeKind sh:Literal ;
        sh:datatype xsd:integer
    ], [
