shacl
@prefix dbo: <http://dbpedia.org/ontology/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

shapes:AstronautShape a sh:NodeShape ;
    sh:targetClass dbo:Astronaut ;
    sh:property [
        sh:path rdf:type ;
        sh:minCount 1 ;
        sh:hasValue dbo:Astronaut
    ] ;
    sh:property [
        sh:path foaf:name ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:nodeKind sh:Literal
    ] ;
    sh:property [
        sh:path dbo:birthDate ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:date ;
        sh:nodeKind sh:Literal
    ] ;
    sh:property [
        sh:path dbo:deathDate ;
        sh:maxCount 1 ;
        sh:datatype xsd:date ;
        sh:nodeKind sh:Literal
    ] ;
    sh:property [
        sh:path dbo:birthName ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:nodeKind sh:Literal
    ] ;
    sh:property [
        sh:path dbo:status ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:nodeKind sh:Literal
    ] ;
    sh:property [
        sh:path dbo:birthPlace ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class dbo:Place
    ] ;
    sh:property [
        sh:path dbo:deathPlace ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class dbo:Place
    ] ;
    sh:property [
        sh:path dbo:almaMater ;
        sh:nodeKind sh:IRI ;
        sh:class dbo:EducationalInstitution
    ] ;
    sh:property [
        sh:path dbo:occupation ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class dbo:Occupation
    ] ;
    sh:property [
        sh:path dbo:mission ;
        sh:nodeKind sh:IRI ;
        sh:class dbo:SpaceMission
    ] ;
    sh:property [
        sh:path dbo:selection ;
        sh:nodeKind sh:IRI ;
        sh:class dbo:SpaceMission
    ] ;
    sh:property [
        sh:path dbo:timeInSpace ;
        sh:maxCount 1 ;
        sh:datatype xsd:double ;
        sh:nodeKind sh:Literal
    ] ;
    sh:property [
        sh:path dbo:retired ;
        sh:maxCount 1 ;
        sh:datatype xsd:date ;
        sh:nodeKind sh:Literal
    ] ;
    sh:property [
        sh:path dbo:award ;
        sh:nodeKind sh:IRI ;
        sh:class dbo:Award
    ] ;
    sh:property [
        sh:path dbo:nationality ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class dbo:Country
    ] ;
    sh:property [
        sh:path dbo:birthYear ;
        sh:maxCount 1 ;
        sh:datatype xsd:gYear ;
        sh:nodeKind sh:Literal
    ] ;
    sh:property [
        sh:path dbo:deathYear ;
        sh:maxCount 1 ;
        sh:datatype xsd:gYear ;
        sh:nodeKind sh:Literal
    ] .