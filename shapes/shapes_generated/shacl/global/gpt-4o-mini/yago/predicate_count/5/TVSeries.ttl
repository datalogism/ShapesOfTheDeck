@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <http://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix yago: <http://yago-knowledge.org/resource/> .

<http://shaclshapes.org/TVSeriesShape> a sh:NodeShape ;
    sh:property [ sh:datatype <rdf:langString> ;
            sh:minCount 1 ;
            sh:path rdfs:label ],
        [ sh:datatype <xsd:anyURI> ;
            sh:path schema:image ],
        [ sh:datatype <xsd:anyURI> ;
            sh:minCount 1 ;
            sh:path schema:mainEntityOfPage ],
        [ sh:node <http://shaclshapes.org/TVSeriesShape> ;
            sh:path schema:productionCompany ],
        [ sh:node <http://shaclshapes.org/TVSeriesShape> ;
            sh:path schema:about ],
        [ sh:datatype <rdf:langString> ;
            sh:path schema:alternateName ],
        [ sh:node <http://shaclshapes.org/TVSeriesShape> ;
            sh:path schema:author ],
        [ sh:node <http://shaclshapes.org/TVSeriesShape> ;
            sh:path schema:musicBy ],
        [ sh:nodeKind sh:IRI ;
            sh:path schema:contentLocation ],
        [ sh:datatype <xsd:decimal> ;
            sh:minCount 1 ;
            sh:path schema:numberOfEpisodes ],
        [ sh:minCount 1 ;
            sh:node <http://shaclshapes.org/TVSeriesShape> ;
            sh:path schema:locationCreated ],
        [ sh:node <http://shaclshapes.org/TVSeriesShape> ;
            sh:path schema:director ],
        [ sh:node <http://shaclshapes.org/TVSeriesShape> ;
            sh:path schema:performer ],
        [ sh:maxCount 2 ;
            sh:nodeKind sh:IRI ;
            sh:path schema:inLanguage ],
        [ sh:node <http://shaclshapes.org/TVSeriesShape> ;
            sh:path yago:appearsIn ],
        [ sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path owl:sameAs ],
        [ sh:minCount 1 ;
            sh:node <http://shaclshapes.org/TVSeriesShape> ;
            sh:path schema:actor ],
        [ sh:datatype <xsd:dateTime> ;
            sh:path schema:dateCreated ],
        [ sh:node <http://shaclshapes.org/TVSeriesShape> ;
            sh:path schema:award ],
        [ sh:datatype <xsd:decimal> ;
            sh:path schema:duration ],
        [ sh:datatype <xsd:string> ;
            sh:maxCount 4 ;
            sh:minCount 1 ;
            sh:path schema:sameAs ],
        [ sh:maxCount 4 ;
            sh:minCount 1 ;
            sh:node <http://shaclshapes.org/TVSeriesShape> ;
            sh:path rdf:type ],
        [ sh:datatype <rdf:langString> ;
            sh:minCount 1 ;
            sh:path rdfs:comment ],
        [ sh:datatype <xsd:anyURI> ;
            sh:minCount 1 ;
            sh:path schema:url ],
        [ sh:datatype <xsd:decimal> ;
            sh:minCount 1 ;
            sh:path schema:numberOfSeasons ] ;
    sh:targetClass schema:TVSeries .

