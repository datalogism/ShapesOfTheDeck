@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <http://schema.org/> .
@prefix yago: <http://yago-knowledge.org/resource/> .

<http://shaclshapes.org/BookShape> a sh:NodeShape ;
    sh:targetClass schema:Book ;
    sh:property [
        sh:path rdf:type ;
        sh:hasValue schema:Book ;
        sh:minCount 1
    ] ,
    [
        sh:path rdfs:label ;
        sh:datatype rdf:langString ;
        sh:minCount 1
    ] ,
    [
        sh:path rdfs:comment ;
        sh:datatype rdf:langString ;
        sh:minCount 0
    ] ,
    [
        sh:path schema:mainEntityOfPage ;
        sh:datatype xsd:anyURI ;
        sh:minCount 0
    ] ,
    [
        sh:path schema:author ;
        sh:class schema:Person ;
        sh:minCount 1
    ] ,
    [
        sh:path schema:dateCreated ;
        sh:datatype xsd:dateTime ;
        sh:minCount 0 ;
        sh:maxCount 1
    ] ,
    [
        sh:path schema:isbn ;
        sh:datatype xsd:string ;
        sh:minCount 0 ;
        sh:maxCount 1
    ] ,
    [
        sh:path schema:publisher ;
        sh:class schema:Organization ;
        sh:minCount 0
    ] ,
    [
        sh:path schema:numberOfPages ;
        sh:datatype xsd:decimal ;
        sh:minCount 0 ;
        sh:maxCount 1
    ] ,
    [
        sh:path schema:inLanguage ;
        sh:class schema:Language ;
        sh:minCount 0
    ] ,
    [
        sh:path schema:contentLocation ;
        sh:class schema:Place ;
        sh:minCount 0
    ] ,
    [
        sh:path schema:editor ;
        sh:class schema:Person ;
        sh:minCount 0
    ] ,
    [
        sh:path schema:illustrator ;
        sh:class schema:Person ;
        sh:minCount 0
    ] ,
    [
        sh:path schema:award ;
        sh:class schema:Award ;
        sh:minCount 0
    ] ,
    [
        sh:path schema:about ;
        sh:class schema:Thing ;
        sh:minCount 0
    ] ,
    [
        sh:path schema:image ;
        sh:datatype xsd:anyURI ;
        sh:minCount 0
    ] ,
    [
        sh:path schema:url ;
        sh:datatype xsd:anyURI ;
        sh:minCount 0
    ] ,
    [
        sh:path schema:alternateName ;
        sh:datatype rdf:langString ;
        sh:minCount 0
    ] .