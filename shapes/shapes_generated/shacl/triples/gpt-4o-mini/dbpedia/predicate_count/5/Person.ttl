@prefix dbo: <http://dbpedia.org/ontology/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shapes: <http://shaclshapes.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

shapes:PersonShape a sh:NodeShape ;
    sh:targetClass dbo:Person ;
    
    sh:property [
        sh:path foaf:name ;
        sh:datatype rdf:langString ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:Literal ;
    ] ;
    
    sh:property [
        sh:path dbo:birthYear ;
        sh:datatype xsd:gYear ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:Literal ;
    ] ;
    
    sh:property [
        sh:path dbo:birthDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:Literal ;
    ] ;
    
    sh:property [
        sh:path dbo:birthPlace ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    
    sh:property [
        sh:path dbo:deathYear ;
        sh:datatype xsd:gYear ;
        sh:maxCount 1 ;
        sh:nodeKind sh:Literal ;
    ] ;
    
    sh:property [
        sh:path dbo:deathDate ;
        sh:datatype xsd:date ;
        sh:maxCount 1 ;
        sh:nodeKind sh:Literal ;
    ] ;
    
    sh:property [
        sh:path dbo:deathPlace ;
        sh:nodeKind sh:IRI ;
        sh:maxCount 1 ;
    ] ;
    
    sh:property [
        sh:path dbo:occupation ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    
    sh:property [
        sh:path dbo:activeYearsStartYear ;
        sh:datatype xsd:gYear ;
        sh:maxCount 1 ;
        sh:nodeKind sh:Literal ;
    ] ;
    
    sh:property [
        sh:path dbo:activeYearsEndYear ;
        sh:datatype xsd:gYear ;
        sh:maxCount 1 ;
        sh:nodeKind sh:Literal ;
    ] ;
    
    sh:property [
        sh:path dbo:alias ;
        sh:datatype rdf:langString ;
        sh:maxCount 1 ;
        sh:nodeKind sh:Literal ;
    ] ;
    
    sh:property [
        sh:path dbo:recordLabel ;
        sh:nodeKind sh:IRI ;
        sh:maxCount 1 ;
    ] ;
    
    sh:property [
        sh:path dbo:associatedBand ;
        sh:nodeKind sh:IRI ;
        sh:maxCount 1 ;
    ] ;
    
    sh:property [
        sh:path dbo:associatedMusicalArtist ;
        sh:nodeKind sh:IRI ;
        sh:maxCount 1 ;
    ] ;
    
    sh:property [
        sh:path dbo:parent ;
        sh:nodeKind sh:IRI ;
        sh:maxCount 1 ;
    ] ;
    
    sh:property [
        sh:path dbo:spouse ;
        sh:nodeKind sh:IRI ;
        sh:maxCount 1 ;
    ] ;
    
    sh:property [
        sh:path dbo:successor ;
        sh:nodeKind sh:IRI ;
        sh:maxCount 1 ;
    ] ;
    
    sh:property [
        sh:path dbo:predecessor ;
        sh:nodeKind sh:IRI ;
        sh:maxCount 1 ;
    ] ;
    
    sh:property [
        sh:path dbo:currentMember ;
        sh:nodeKind sh:IRI ;
        sh:maxCount 1 ;
    ] ;
    
    sh:property [
        sh:path dbo:team ;
        sh:nodeKind sh:IRI ;
        sh:maxCount 1 ;
    ] ;
    
    sh:property [
        sh:path dbo:squadNumber ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:nodeKind sh:Literal ;
    ] ;
    
    sh:property [
        sh:path dbo:background ;
        sh:datatype rdf:langString ;
        sh:maxCount 1 ;
        sh:nodeKind sh:Literal ;
    ] ;
    
    sh:property [
        sh:path dbo:genre ;
        sh:nodeKind sh:IRI ;
        sh:maxCount 1 ;
    ] ;
    
    sh:property [
        sh:path dbo:termPeriod ;
        sh:nodeKind sh:IRI ;
        sh:maxCount 1 ;
    ] .