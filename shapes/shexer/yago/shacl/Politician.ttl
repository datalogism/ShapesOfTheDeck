@prefix : <http://weso.es/shapes/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema1: <http://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix yago: <http://yago-knowledge.org/resource/> .

:Politician a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:dataType xsd:string ;
            sh:path rdfs:label ],
        [ a sh:PropertyShape ;
            sh:dataType xsd:string ;
            sh:maxCount 1 ;
            sh:path schema1:deathDate ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path schema1:gender ],
        [ a sh:PropertyShape ;
            sh:dataType xsd:string ;
            sh:path schema1:sameAs ],
        [ a sh:PropertyShape ;
            sh:in ( yago:Politician ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path rdf:type ],
        [ a sh:PropertyShape ;
            sh:nodeKind sh:IRI ;
            sh:path schema1:image ],
        [ a sh:PropertyShape ;
            sh:nodeKind sh:IRI ;
            sh:path schema1:mainEntityOfPage ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path schema1:birthPlace ],
        [ a sh:PropertyShape ;
            sh:nodeKind sh:IRI ;
            sh:path schema1:alumniOf ],
        [ a sh:PropertyShape ;
            sh:nodeKind sh:IRI ;
            sh:path yago:candidateIn ],
        [ a sh:PropertyShape ;
            sh:dataType xsd:string ;
            sh:path schema1:alternateName ],
        [ a sh:PropertyShape ;
            sh:dataType xsd:string ;
            sh:maxCount 1 ;
            sh:path schema1:birthDate ],
        [ a sh:PropertyShape ;
            sh:nodeKind sh:IRI ;
            sh:path schema1:knowsLanguage ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path owl:sameAs ],
        [ a sh:PropertyShape ;
            sh:dataType xsd:string ;
            sh:path rdfs:comment ],
        [ a sh:PropertyShape ;
            sh:nodeKind sh:IRI ;
            sh:path schema1:memberOf ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path schema1:deathPlace ],
        [ a sh:PropertyShape ;
            sh:nodeKind sh:IRI ;
            sh:path schema1:nationality ] ;
    sh:targetClass yago:Politician .

